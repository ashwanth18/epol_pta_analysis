{
  "name": "penmill-analytics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ensure-data": "node scripts/ensure-data.mjs",
    "dev": "npm run ensure-data && next dev",
    "dev:fast": "npm run ensure-data && next dev",
    "build": "npm run ensure-data && rm -rf .next && next build",
    "start": "next start",
    "clean": "rm -rf .next",
    "lint": "next lint",
    "export-data": "python3 scripts/export.py",
    "setup-python": "python3 -m pip install -r requirements.txt"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "lucide-react": "^0.408.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  }
}
